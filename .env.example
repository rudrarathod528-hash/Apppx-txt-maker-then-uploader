# ============================================================
# APPX Course Bot — environment configuration (.env)
# Is file ko copy karke .env banayein aur apne values bharein:
#   cp .env.example .env
# ============================================================

# ---- Telegram (REQUIRED in live mode) ----
# @BotFather se token lo
BOT_TOKEN=
# Admin/owner Telegram user IDs (comma-separated) — /admin access
ADMIN_IDS=

# ---- Platform ----
# live = real ClassX/AppX tenant API | mock = demo (demo/demo123)
PLATFORM_MODE=live
# Optional: single-tenant deployment me set karo, warna appxapis.json se auto
# PLATFORM_BASE_URL=https://aashapi.appx.co.in
PLATFORM_LOGIN_PATH=/api/v1/login
PLATFORM_COURSES_PATH=/api/v1/user/courses
PLATFORM_CONTENT_PATH=/api/v1/course/{course_id}/content
PLATFORM_LOGIN_USERNAME_KEY=username
PLATFORM_LOGIN_PASSWORD_KEY=password
# Token response me kahan hai (comma-separated dotted paths)
PLATFORM_TOKEN_JSON_PATH=data.token,data.access_token,data.auth_token,data.jwt,token,access_token,auth_token,jwt
PLATFORM_TOKEN_HEADER=Authorization
PLATFORM_TOKEN_SCHEME=Bearer

# ---- Storage ----
DATABASE_PATH=data/appx.db
EXPORT_DIR=/tmp/appx/exports
JOB_DIR=/tmp/appx/jobs

# ---- Limits ----
FILE_TTL_HOURS=24
MAX_UPLOAD_MB=1950
MAX_RETRIES=3
RETRY_BACKOFF_SEC=5,15,30
MAX_ACTIVE_JOBS=5
MAX_JOBS_PER_USER=3
EXPORT_MODE=single            # single | separate
# TXT me media reference kaise likhein:
#   base = sirf host+path (signed query params hatao) — default, safe
#   full = platform-provided complete reference (signed URL bhi) —
#          personal authorized use; links expire ho sakti hain
TXT_REFERENCE_MODE=base
JOBS_RETENTION_DAYS=30
CLEANUP_INTERVAL_MIN=60

# ---- Security ----
# Fernet key (32-byte urlsafe base64). Na do to data/appx.secret me auto-generate hoga.
# Production me hamesha set karo!
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Rate limits ----
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300
API_RATE_LIMIT=30
API_RATE_WINDOW=60
EXPORT_RATE_LIMIT=5
EXPORT_RATE_WINDOW=600

# ---- Misc ----
LOG_LEVEL=INFO
REGISTRY_PATH=appxapis.json
CONTENT_CACHE_TTL_SEC=600
MEDIA_TIMEOUT_SEC=900
FFMPEG_TIMEOUT_SEC=1800
